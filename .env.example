# ============================================================================
# DesaWisata Nusantara — Environment Variables (TEMPLATE)
# ============================================================================
# Cara pakai:
#   1. Salin file ini:  cp .env.example .env
#   2. Isi nilai asli di .env (JANGAN pernah commit .env ke repository!)
#   3. Backend otomatis memuat .env saat startup (loader di Program.cs).
#      Frontend membaca .env yang sama via Vite (envDir di vite.config.ts) —
#      hanya variabel berawalan VITE_ yang masuk ke bundle browser.
#   4. Deployment formal (systemd/Docker/IIS): set env var lewat platform,
#      tidak wajib memakai file .env.
#
# PENTING: VITE_API_URL dibaca saat BUILD frontend (`npm run build`), bukan
# saat runtime. Ubah nilai ini -> build ulang frontend.
# ============================================================================

# ----------------------------------------------------------------------------
# KEAMANAN (WAJIB di production)
# ----------------------------------------------------------------------------

# Kunci signing JWT — minimal 32 karakter, acak, unik per environment.
# Generate: openssl rand -hex 64   (atau PowerShell: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) }))
# Kalau kosong: development memakai file jwt_dev_secret.txt; production
# digenerate acak per startup (semua login invalid setelah restart).
JWT_SECRET_KEY=

# Password awal akun SuperAdmin yang di-seed (superadmin@desawisata.go.id).
# WAJIB di production — backend MENOLAK START bila kosong.
# Akun yang sudah ada di database tidak diubah oleh seeder.
SEED_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# LAYANAN EKSTERNAL
# ----------------------------------------------------------------------------

# API key Groq untuk chatbot WisataBot (mode LLM).
# Tanpa key ini chatbot tetap jalan dalam mode fallback (rule-based).
# Generate di https://console.groq.com — jangan pernah commit key asli!
GROQ_API_KEY=

# Model Groq yang dipakai (opsional; default openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# ----------------------------------------------------------------------------
# JEV GATE — filter off-topic sebelum Groq (TypeSafe AI via Cloudflare Workers AI)
# ----------------------------------------------------------------------------

# Model typesafe/jev diklasifikasi "off-topic" (murah & cepat, ~70-500ms).
# Kalau keduanya kosong: gate otomatis nonaktif, semua pertanyaan langsung ke Groq.
# Ambil di https://dash.cloudflare.com -> AI -> Workers AI (butuh API Token dengan
# permission "Workers AI: Edit" di profil akun -> API Tokens).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Ambang probabilitas penolakan off-topic (0-1, default 0.85). Makin tinggi = makin
# jarang menolak (aman dari false positive). Error/fail gate = fail-open ke Groq.
# JEV_GATE_THRESHOLD=0.85

# ----------------------------------------------------------------------------
# CORS & NETWORK
# ----------------------------------------------------------------------------

# Origin frontend yang diizinkan memanggil API (production).
# Pisahkan beberapa origin dengan koma. Kosong = mode dev (hanya localhost).
# Contoh: https://desawisataanda.com,https://www.desawisataanda.com
CORS_ORIGINS=

# URL publik API yang dipakai frontend saat build (TANPA trailing slash).
# Development tidak perlu diisi (fallback http://localhost:5200).
# Contoh production: https://api.desawisataanda.com
VITE_API_URL=

# MODE DEMO (frontend only — tanpa backend, tanpa ubah tampilan).
# true  = halaman publik memakai data mock (landing, profil desa, booking,
#         peta, chatbot). Cocok untuk demo/presentasi tanpa backend berjalan.
# false = (default) memakai backend asli. Ubah nilai ini wajib restart
#         dev server / build ulang frontend.
# VITE_DEMO_MODE=false

# ----------------------------------------------------------------------------
# DATABASE & RUNTIME (opsional)
# ----------------------------------------------------------------------------

# Koneksi database. Default: Data Source=desawisata.db (SQLite lokal).
# Contoh: Data Source=/var/data/desawisata.db;Cache=Shared
# ConnectionStrings__DefaultConnection=

# Environment ASP.NET Core: Development | Production (default Production saat deploy)
# ASPNETCORE_ENVIRONMENT=Production
